        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="10 • ERD / รอบบิล–มิเตอร์–รับชำระ" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#EFF6FF;strokeColor=#2B5B93;strokeWidth=1.5;text;html=1;fontSize=26;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="2590" height="45" />
        </mxCell>
        <mxCell id="note1" value="PK = Primary Key • FK = Foreign Key • ? = nullable • เส้น: ตารางแม่ 1 → ตารางลูก 0..N (FK nullable จึงอาจไม่มีแม่)&lt;br&gt;REF = ตารางอ้างอิงจากหน้าอื่น • ERD ทุก FK ตรงกับไฟล์ SQL; ความสัมพันธ์แบบ bridge มี UNIQUE ป้องกันคู่ซ้ำ" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#EFF6FF;strokeColor=#2B5B93;strokeWidth=1.5;fillColor=#FFFBEB;strokeColor=#D4AA42;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
