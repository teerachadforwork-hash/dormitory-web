        <mxCell id="e23" value="รายการเรียกเก็บเมื่อย้าย / สิ้นสุดสัญญา" edge="1" parent="1" source="tenancy" target="a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=12;strokeColor=#526779;strokeWidth=1.3;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note14" value="Level 2 รักษาข้อมูลเข้า/ออกของ 3.0 ใน Level 1: E2, E1, D1, D2, D3, 2.0, 5.0 และ 6.0&lt;br&gt;สูตรหน่วยใช้ = ค่าปัจจุบัน − ค่าก่อนหน้า + จำนวนรอบหมุน × ขนาดครบหนึ่งรอบ; มิเตอร์เปลี่ยนเครื่องต้องบันทึกแยก&lt;br&gt;Invoice Item เก็บ snapshot ราคา ภาษี หน่วย และสูตร เพื่อไม่ให้การเปลี่ยนอัตราภายหลังเปลี่ยนบิลเก่า" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#EFF6FF;strokeColor=#2B5B93;strokeWidth=1.5;fillColor=#FFFBEB;strokeColor=#D4AA42;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1460" width="1840" height="100" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
